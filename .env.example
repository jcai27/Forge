ENVIRONMENT=development
DATABASE_URL=sqlite:///./factory.db
REDIS_URL=redis://localhost:6379/0
# demo, live, or hybrid (built-in templates on fixtures, custom agents on the real model).
EXECUTION_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible endpoint, for example a local model server. Empty uses the OpenAI API.
OPENAI_BASE_URL=
# responses (OpenAI) or chat_completions (most compatible servers).
OPENAI_API=responses
# schema sends output JSON Schemas to the provider; prompt puts them in the instructions instead,
# for servers that cannot compile large schemas. Replies are validated in code either way.
OPENAI_STRUCTURED_OUTPUT=schema
JWT_SECRET=local-development-only-change-before-deployment
ENCRYPTION_KEY=
# Flat price per token for a model with no entry in MODEL_PRICES.
ESTIMATED_TOKEN_COST=0.000005
# Dollars per million tokens as [input, output, cached input]. Check against the provider.
# MODEL_PRICES={"gpt-5.5":[5.0,30.0,0.5],"gpt-4.1-mini":[0.4,1.6,0.1]}
# Models the builder may move an agent to. Empty: it cannot change the model.
# AGENT_MODELS=[]
# low, medium or high for reasoning models; empty leaves the provider default.
# AGENT_REASONING_EFFORT=
# BUILDER_REASONING_EFFORT=
# Live evaluation trials run side by side.
# EVALUATION_CONCURRENCY=8
# Largest reply to request; 0 leaves it to the model.
# OUTPUT_TOKEN_LIMIT=0
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Model for factory roles (architect, optimizer, test designer, researcher). Defaults to OPENAI_MODEL.
BUILDER_MODEL=
# Open-web research for the builder. Off by default. Optional JSON search endpoint with {query}.
RESEARCH_ENABLED=false
# Read scanned pages and photos by sending each page image to the model provider. Charged per
# page (a few cents on a large model). READER_MODEL falls back to OPENAI_MODEL.
DOCUMENT_READING=false
# READER_MODEL=
# READING_MAX_COST=10
RESEARCH_SEARCH_URL=
RESEARCH_SEARCH_HEADER=
# Unix socket of the sandbox service that runs builder-written tools. Empty disables them.
# Docker Compose sets this for the API and worker. Never run tool code in-process instead.
SANDBOX_SOCKET=
